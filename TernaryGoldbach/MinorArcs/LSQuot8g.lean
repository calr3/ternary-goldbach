set_option maxRecDepth 100000 in
theorem blocksP_cover : ∀ n < 2600, 4 ≤ n →
    blocksP.any (fun x => decide (x.1 ≤ n) && decide (n ≤ x.2.1)) = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem walk_all : ∀ A ∈ (30030 : ℕ).divisors,
    walkB A (KQ A) (0.1768 * KQ A * FupA A) (WQ A) 0 0 blocksP = true := by decide +kernel

/-- **`Φ(A, n, log A) ≤ 0`** for `A ∣ 30030`, `n ≥ 4`. -/
theorem Phi2_base {A n : ℕ} (hA : A ∣ 30030) (hn : 4 ≤ n) : Phi2 A n (Real.log A) ≤ 0 := by
  rcases le_or_gt 2600 n with h | h
  · exact Phi2_tail hA h
  have hc := blocksP_cover n h hn
  rw [List.any_eq_true] at hc
  obtain ⟨x, hx, hxn⟩ := hc
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hxn
  have hw := walk_all A (Nat.mem_divisors.2 ⟨hA, by norm_num⟩)
  have hU0 : UA A 0 = 0 := by simp [UA]
  rw [← hU0] at hw
  have hb := walkB_spec A _ _ _ blocksP 0 hw x hx
  exact Phi2_of_block hA hb hxn.1 hxn.2

