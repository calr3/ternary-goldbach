    √(12 * a1F0 L * bX0 L * bB0 L) + bSEC L ≤ 1.413 * (L * √L) := by
  rcases le_or_gt L 17 with hb_piece_0 | hb_piece_0
  · exact b_piece_0 (by linarith) hb_piece_0
  rcases le_or_gt L 18.78 with hb_piece_1 | hb_piece_1
  · exact b_piece_1 (by linarith) hb_piece_1
