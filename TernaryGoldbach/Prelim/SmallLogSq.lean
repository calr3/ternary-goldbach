import TernaryGoldbach.Prelim.SmallProdAp
import TernaryGoldbach.Prelim.SmallMertens

/-!
# `∑_{n/2 < p ≤ n} (log p)² ≤ ½ n log n` for `117 ≤ n < 40000`, checked by the kernel

The chunk `Q k` lists the primes in `[1000k, 1000k + 1000)` (complete by `scan`) with `u_p`,
`log p < u_p/10⁶` (`chkStep`). For a block `[A, B)` and `A ≤ n < B`,
`∑_{n/2 < p ≤ n} (log p)² ≤ ∑_{A/2 < p ≤ B−1} u_p²/10¹² ≤ ½ A l_A/10⁶ ≤ ½ n log n`; the kernel checks
the middle inequality (`wsC`, which visits only the chunks meeting the window) and
`l_A/10⁶ ≤ log A` (`chkLow`). 225 blocks cover `[117, 40000)`. Only upper bounds are used, so the
tables need not be sorted or free of repeats.
-/

open Finset

namespace TernaryGoldbach.Prelim.SmallLS

open TernaryGoldbach.Prelim.Small (scan scan_spec chkStep chkLow log_lt_of_chk le_log_of_chk)

/-- A chunk at index `k`: complete for the primes in `[1000k, 1000k + 1000)`, with log bounds. -/
def chunkOK (k : ℕ) (c : List (ℕ × ℕ)) : Bool :=
  scan 1000 (1000 * k) (c.map Prod.fst) &&
    c.all (fun pu => decide (0 < pu.1) && chkStep pu.2 (10 ^ 6) 1 pu.1)

