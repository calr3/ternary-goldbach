/-- `∑_{pu ∈ c, lo < p ≤ hi} u_p²`. -/
def csum (lo hi : ℕ) (c : List (ℕ × ℕ)) : ℕ :=
  ((c.filter (fun pu => decide (lo < pu.1) && decide (pu.1 ≤ hi))).map (fun pu => pu.2 ^ 2)).sum

/-- `csum` over the chunks `k, k+1, …` that meet `(lo, hi]`. -/
def wsC (lo hi : ℕ) : ℕ → List (List (ℕ × ℕ)) → ℕ
  | _, [] => 0
  | k, c :: cs =>
    if hi < 1000 * k then 0
    else (if 1000 * k + 999 ≤ lo then 0 else csum lo hi c) + wsC lo hi (k + 1) cs

theorem sum_map_sq_div (l : List (ℕ × ℕ)) :
    (l.map (fun pu => ((pu.2 : ℝ) / 10 ^ 6) ^ 2)).sum =
      (((l.map (fun pu => pu.2 ^ 2)).sum : ℕ) : ℝ) / 10 ^ 12 := by
  induction l with
  | nil => simp
  | cons x l ih => simp only [List.map_cons, List.sum_cons, ih]; push_cast; ring

theorem toFinset_sum_le (l : List (ℕ × ℕ)) (f : ℕ × ℕ → ℝ) (hf : ∀ x, 0 ≤ f x) :
    ∑ x ∈ l.toFinset, f x ≤ (l.map f).sum := by
  rw [Finset.sum_list_map_count]
  refine sum_le_sum fun x hx => ?_
  have hc : 1 ≤ l.count x := List.count_pos_iff.2 (List.mem_toFinset.1 hx)
  rw [nsmul_eq_mul]
  exact le_mul_of_one_le_left (hf x) (by exact_mod_cast hc)

theorem chunk_le {k : ℕ} {c : List (ℕ × ℕ)} (h : chunkOK k c = true) (lo hi : ℕ) :
    ∑ p ∈ (Ioc lo hi).filter (fun p => p.Prime ∧ 1000 * k ≤ p ∧ p < 1000 * k + 1000),
      Real.log p ^ 2 ≤ (csum lo hi c : ℝ) / 10 ^ 12 := by
  unfold chunkOK at h
  rw [Bool.and_eq_true] at h
  obtain ⟨hscan, hall⟩ := h
  set F := c.filter (fun pu => decide (lo < pu.1) && decide (pu.1 ≤ hi)) with hF
  have hsub : (Ioc lo hi).filter (fun p => p.Prime ∧ 1000 * k ≤ p ∧ p < 1000 * k + 1000) ⊆
      F.toFinset.image Prod.fst := by
    intro p hp
    simp only [mem_filter, mem_Ioc] at hp
    obtain ⟨⟨hlo, hhi⟩, hpr, hk1, hk2⟩ := hp
    have hm := scan_spec 1000 (1000 * k) _ hscan p hk1 (by omega) hpr
    obtain ⟨pu, hpu, rfl⟩ := List.mem_map.1 hm
    refine mem_image.2 ⟨pu, List.mem_toFinset.2 ?_, rfl⟩
    rw [hF, List.mem_filter]
    exact ⟨hpu, by simp [hlo, hhi]⟩
  have hlog : ∀ pu ∈ c, Real.log pu.1 < (pu.2 : ℝ) / 10 ^ 6 := by
    intro pu hpu
    have hc := List.all_eq_true.1 hall pu hpu
    rw [Bool.and_eq_true, decide_eq_true_eq] at hc
    have := log_lt_of_chk (by norm_num) hc.1 hc.2
    push_cast at this; linarith
  calc ∑ p ∈ (Ioc lo hi).filter (fun p => p.Prime ∧ 1000 * k ≤ p ∧ p < 1000 * k + 1000),
        Real.log p ^ 2
      ≤ ∑ p ∈ F.toFinset.image Prod.fst, Real.log p ^ 2 :=
        sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => sq_nonneg _
    _ ≤ ∑ pu ∈ F.toFinset, Real.log pu.1 ^ 2 :=
        sum_image_le_of_nonneg fun _ _ => sq_nonneg _
    _ ≤ ∑ pu ∈ F.toFinset, ((pu.2 : ℝ) / 10 ^ 6) ^ 2 := by
        refine sum_le_sum fun pu hpu => ?_
        have hm : pu ∈ c := (List.mem_filter.1 (List.mem_toFinset.1 hpu)).1
        exact pow_le_pow_left₀ (Real.log_natCast_nonneg _) (hlog pu hm).le 2
    _ ≤ (F.map (fun pu => ((pu.2 : ℝ) / 10 ^ 6) ^ 2)).sum :=
        toFinset_sum_le F _ fun _ => sq_nonneg _
    _ = (csum lo hi c : ℝ) / 10 ^ 12 := by rw [sum_map_sq_div]; rfl

theorem wsC_spec (lo hi : ℕ) : ∀ (cs : List (List (ℕ × ℕ))) (k : ℕ),
    (∀ i < cs.length, chunkOK (k + i) (cs.getD i []) = true) →
    ∑ p ∈ (Ioc lo hi).filter (fun p => p.Prime ∧ 1000 * k ≤ p ∧ p < 1000 * (k + cs.length)),
      Real.log p ^ 2 ≤ (wsC lo hi k cs : ℝ) / 10 ^ 12
  | [], k, _ => by
    simp only [List.length_nil, add_zero]
    rw [show (Ioc lo hi).filter (fun p => p.Prime ∧ 1000 * k ≤ p ∧ p < 1000 * k) = ∅ by
      ext p; simp only [mem_filter, Finset.notMem_empty, iff_false]; rintro ⟨_, _, h1, h2⟩; omega,
      sum_empty]
    simp [wsC]
  | c :: cs, k, h => by
    have h0 : chunkOK k c = true := by simpa using h 0 (by simp)
    have h1 : ∀ i < cs.length, chunkOK (k + 1 + i) (cs.getD i []) = true := by
      intro i hi
      have := h (i + 1) (by simp; omega)
      rw [List.getD_cons_succ, show k + (i + 1) = k + 1 + i by omega] at this
      exact this
    have ih := wsC_spec lo hi cs (k + 1) h1
    set S := (Ioc lo hi).filter
      (fun p => p.Prime ∧ 1000 * k ≤ p ∧ p < 1000 * (k + (c :: cs).length))
    have e1 : S.filter (fun p => p < 1000 * k + 1000) =
        (Ioc lo hi).filter (fun p => p.Prime ∧ 1000 * k ≤ p ∧ p < 1000 * k + 1000) := by
      rw [filter_filter]; refine filter_congr fun p _ => ?_; simp only [List.length_cons]
      by_cases hp : p.Prime <;> simp [hp] <;> omega
    have e2 : S.filter (fun p => ¬ p < 1000 * k + 1000) =
        (Ioc lo hi).filter (fun p => p.Prime ∧ 1000 * (k + 1) ≤ p ∧ p < 1000 * (k + 1 + cs.length)) := by
      rw [filter_filter]; refine filter_congr fun p _ => ?_; simp only [List.length_cons]
      by_cases hp : p.Prime <;> simp [hp] <;> omega
    rw [← sum_filter_add_sum_filter_not S (fun p => p < 1000 * k + 1000), e1, e2]
    have hz : ∀ T : Finset ℕ, T = ∅ → ∑ p ∈ T, Real.log p ^ 2 = 0 := fun T hT => by rw [hT, sum_empty]
    rw [wsC]
    split_ifs with hhi hlo
    · rw [hz _ (by ext p; simp only [mem_filter, mem_Ioc, Finset.notMem_empty, iff_false]; rintro ⟨⟨_, _⟩, _, _, _⟩; omega),
        hz _ (by ext p; simp only [mem_filter, mem_Ioc, Finset.notMem_empty, iff_false]; rintro ⟨⟨_, _⟩, _, _, _⟩; omega)]
      simp
    · rw [hz _ (by ext p; simp only [mem_filter, mem_Ioc, Finset.notMem_empty, iff_false]; rintro ⟨⟨_, _⟩, _, _, _⟩; omega)]
      push_cast; linarith
    · have := chunk_le h0 lo hi
      push_cast; rw [add_div]; linarith

theorem QC_length : QC.length = 40 := rfl

theorem sum_le_ws (lo hi : ℕ) (hhi : hi < 40000) :
    ∑ p ∈ (Ioc lo hi).filter Nat.Prime, Real.log p ^ 2 ≤ (wsC lo hi 0 QC : ℝ) / 10 ^ 12 := by
  have h := wsC_spec lo hi QC 0 QC_ok
  rw [QC_length] at h
  have e : (Ioc lo hi).filter Nat.Prime =
      (Ioc lo hi).filter (fun p => p.Prime ∧ 1000 * 0 ≤ p ∧ p < 1000 * (0 + 40)) := by
    refine filter_congr fun p hp => ?_; have := (mem_Ioc.1 hp).2
    by_cases hq : p.Prime <;> simp [hq] <;> omega
  rw [e]; exact h

theorem block_ok {A lo hi l N : ℕ} (hws : 2 * wsC lo hi 0 QC ≤ A * l * 10 ^ 6)
    (hl : chkLow l (10 ^ 6) A = true) (hlo : lo = A / 2) (hA : A ≤ N) (hN : N ≤ hi)
    (hhi : hi < 40000) (hA1 : 1 ≤ A) :
    ∑ p ∈ (Ioc (N / 2) N).filter Nat.Prime, Real.log p ^ 2 ≤ 1 / 2 * N * Real.log N := by
  have hlo' : lo ≤ N / 2 := hlo ▸ Nat.div_le_div_right hA
  have hsub : (Ioc (N / 2) N).filter Nat.Prime ⊆ (Ioc lo hi).filter Nat.Prime :=
    filter_subset_filter _ (Ioc_subset_Ioc hlo' hN)
  refine (sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => sq_nonneg _).trans ?_
  refine (sum_le_ws lo hi hhi).trans ?_
  have hlog : (l : ℝ) / 10 ^ 6 ≤ Real.log A := by
    have h := le_log_of_chk (by norm_num) (by omega) hl
    push_cast at h; linarith
  have hws' : (2 : ℝ) * wsC lo hi 0 QC ≤ A * l * 10 ^ 6 := by exact_mod_cast hws
  have hA' : (1 : ℝ) ≤ A := by exact_mod_cast hA1
  have hAN : (A : ℝ) ≤ N := by exact_mod_cast hA
  have hlA : Real.log A ≤ Real.log N := Real.log_le_log (by linarith) hAN
  have hl0 : 0 ≤ Real.log A := Real.log_nonneg hA'
  have h1 : (wsC lo hi 0 QC : ℝ) / 10 ^ 12 ≤ 1 / 2 * A * ((l : ℝ) / 10 ^ 6) := by
    rw [div_le_iff₀ (by norm_num)]
    have e : 1 / 2 * (A : ℝ) * ((l : ℝ) / 10 ^ 6) * 10 ^ 12 = A * l * 10 ^ 6 / 2 := by ring
    rw [e]; linarith
  have h2 : 1 / 2 * (A : ℝ) * ((l : ℝ) / 10 ^ 6) ≤ 1 / 2 * A * Real.log A :=
    mul_le_mul_of_nonneg_left hlog (by positivity)
  have h3 := mul_le_mul hAN hlA hl0 (by linarith)
  linarith

