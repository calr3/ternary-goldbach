/-- **`θ` on `[10⁶, 2·10⁸)`**: `θ(t) ≤ t + 0.1√t` and `t − θ(t) ≤ 2√t`. -/
theorem sieve_table2 {t : ℝ} (h1 : 1000000 ≤ t) (h2 : t < 200000000) : RtT 2 1 1 10 t :=
  (stg853).1 t h1 (by exact_mod_cast h2)

/-- `θ(t) ≤ t + 3√t` and `t − θ(t) ≤ 5√t` on `[10⁶, 5·10⁷)`. -/
theorem sieve_table {t : ℝ} (h1 : 1000000 ≤ t) (h2 : t < 50000000) : RtT 5 1 3 1 t := by
  have h := sieve_table2 h1 (by linarith)
  have hs : 0 ≤ √t := Real.sqrt_nonneg t
  unfold RtT at h ⊢
  norm_num at h ⊢
  constructor <;> linarith [h.1, h.2]

