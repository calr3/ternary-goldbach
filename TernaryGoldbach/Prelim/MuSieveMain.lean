theorem Mz_start : Mz 2160534 = -498 := by
  have h := SmallMu.sum_mu_eq 2160534
  obtain ⟨hs, -⟩ := SmallMu.u1080
  simp only [Prod.mk.injEq] at hs
  rw [hs.1, hs.2.1] at h
  have : (Mz 2160534 : ℝ) = ∑ n ∈ Icc 1 2160534, (μ n : ℝ) := by unfold Mz; push_cast; rfl
  rw [this, h]; norm_num

