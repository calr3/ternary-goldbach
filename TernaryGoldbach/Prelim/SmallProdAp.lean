/-- Trial division by `2 ≤ d ≤ 100` with `d² ≤ p` (enough for `p < 10⁴`). -/
def primeCheck (p : ℕ) : Bool :=
  2 ≤ p && (List.range' 2 99).all (fun d => p < d * d || p % d != 0)

/-- A divisor of `n` in `[2, n)`. -/
def hasDiv (n : ℕ) : Bool := (List.range' 2 (n - 2)).any (fun d => n % d == 0)

/-- Scans `n, …, n + f − 1` against the sorted remaining table `P`. -/
def scan : ℕ → ℕ → List ℕ → Bool
  | 0, _, P => P.isEmpty
  | f + 1, n, [] => (n < 2 || hasDiv n) && scan f (n + 1) []
  | f + 1, n, p :: P =>
    if n = p then scan f (n + 1) P else (n < 2 || hasDiv n) && scan f (n + 1) (p :: P)

/-- The factor bound `1 + (r² + r)/(p − 1)`, `r = k/10⁶`. -/
def fac (pk : ℕ × ℕ) : ℚ :=
  1 + (((pk.2 : ℚ) / 10 ^ 6) ^ 2 + (pk.2 : ℚ) / 10 ^ 6) / ((pk.1 : ℚ) - 1)

/-- The per-entry check. -/
def entryCheck (pk : ℕ × ℕ) : Bool :=
  primeCheck pk.1 && decide (pk.1 < 10000) && decide (10 ^ 18 ≤ pk.1 * pk.2 ^ 3)

