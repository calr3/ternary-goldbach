theorem prime_of_primeCheck {p : ℕ} (hp : p < 10000) (h : primeCheck p = true) : p.Prime := by
  unfold primeCheck at h
  simp only [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_range'_1,
    Bool.or_eq_true, bne_iff_ne, ne_eq] at h
  rw [Nat.prime_def_le_sqrt]
  refine ⟨h.1, fun m hm2 hms hdvd => ?_⟩
  have hmm : m * m ≤ p := Nat.le_sqrt.1 hms
  have hm100 : m ≤ 99 := by nlinarith
  rcases h.2 m ⟨hm2, by omega⟩ with h1 | h1
  · omega
  · exact h1 (Nat.mod_eq_zero_of_dvd hdvd)

theorem not_prime_of_hasDiv {n : ℕ} (h : hasDiv n = true) : ¬ n.Prime := by
  unfold hasDiv at h
  simp only [List.any_eq_true, List.mem_range'_1, beq_iff_eq] at h
  obtain ⟨d, ⟨hd2, hdn⟩, hmod⟩ := h
  intro hp
  have hdvd : d ∣ n := Nat.dvd_of_mod_eq_zero hmod
  rcases hp.eq_one_or_self_of_dvd d hdvd with h1 | h1 <;> omega

theorem scan_spec : ∀ f n P, scan f n P = true →
    ∀ m, n ≤ m → m < n + f → m.Prime → m ∈ P := by
  intro f
  induction f with
  | zero => intro n P _ m h1 h2; omega
  | succ f ih =>
    intro n P h m h1 h2 hm
    cases P with
    | nil =>
      rw [scan, Bool.and_eq_true] at h
      rcases (show m = n ∨ n + 1 ≤ m by omega) with rfl | hm1
      · rcases Bool.or_eq_true _ _ ▸ h.1 with h3 | h3
        · have := hm.two_le; simp at h3; omega
        · exact absurd hm (not_prime_of_hasDiv h3)
      · exact ih (n + 1) [] h.2 m hm1 (by omega) hm
    | cons p P =>
      rw [scan] at h
      split_ifs at h with hnp
      · rcases (show m = n ∨ n + 1 ≤ m by omega) with rfl | hm1
        · exact hnp ▸ List.mem_cons_self
        · exact List.mem_cons_of_mem _ (ih (n + 1) P h m hm1 (by omega) hm)
      · rw [Bool.and_eq_true] at h
        rcases (show m = n ∨ n + 1 ≤ m by omega) with rfl | hm1
        · rcases Bool.or_eq_true _ _ ▸ h.1 with h3 | h3
          · have := hm.two_le; simp at h3; omega
          · exact absurd hm (not_prime_of_hasDiv h3)
        · exact ih (n + 1) (p :: P) h.2 m hm1 (by omega) hm

/-- The table lists exactly the primes below `10⁴`. -/
theorem primesBelow_eq : Nat.primesBelow 10000 = (PK.map Prod.fst).toFinset := by
  have hent := PK_entries
  simp only [List.all_eq_true, entryCheck, Bool.and_eq_true, decide_eq_true_eq] at hent
  ext p
  rw [Nat.mem_primesBelow, List.mem_toFinset]
  constructor
  · rintro ⟨hp, hpr⟩
    rw [PK_fst]
    simp only [List.mem_append]
    have hi : p / 1000 < 10 := by omega
    interval_cases h : p / 1000
    · have hm := scan_spec 1000 0 Q0 PK_scan0 p (by omega) (by omega) hpr
      simp [hm]
    · have hm := scan_spec 1000 1000 Q1 PK_scan1 p (by omega) (by omega) hpr
      simp [hm]
    · have hm := scan_spec 1000 2000 Q2 PK_scan2 p (by omega) (by omega) hpr
      simp [hm]
    · have hm := scan_spec 1000 3000 Q3 PK_scan3 p (by omega) (by omega) hpr
      simp [hm]
    · have hm := scan_spec 1000 4000 Q4 PK_scan4 p (by omega) (by omega) hpr
      simp [hm]
    · have hm := scan_spec 1000 5000 Q5 PK_scan5 p (by omega) (by omega) hpr
      simp [hm]
    · have hm := scan_spec 1000 6000 Q6 PK_scan6 p (by omega) (by omega) hpr
      simp [hm]
    · have hm := scan_spec 1000 7000 Q7 PK_scan7 p (by omega) (by omega) hpr
      simp [hm]
    · have hm := scan_spec 1000 8000 Q8 PK_scan8 p (by omega) (by omega) hpr
      simp [hm]
    · have hm := scan_spec 1000 9000 Q9 PK_scan9 p (by omega) (by omega) hpr
      simp [hm]
  · intro hp
    obtain ⟨pk, hpk, rfl⟩ := List.mem_map.1 hp
    obtain ⟨⟨h1, h2⟩, h3⟩ := hent pk hpk
    exact ⟨h2, prime_of_primeCheck h2 h1⟩

/-- `p^{−1/3} ≤ k/10⁶` when `p k³ ≥ 10¹⁸`. -/
theorem rpow_third_le {p k : ℕ} (hp : 0 < p) (h : 10 ^ 18 ≤ p * k ^ 3) :
    (p : ℝ) ^ (-(1 / 3) : ℝ) ≤ (k : ℝ) / 10 ^ 6 := by
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp
  have hr0 : (0 : ℝ) ≤ (k : ℝ) / 10 ^ 6 := by positivity
  have hcube : (1 : ℝ) ≤ (p : ℝ) * ((k : ℝ) / 10 ^ 6) ^ 3 := by
    have : ((10 ^ 18 : ℕ) : ℝ) ≤ ((p * k ^ 3 : ℕ) : ℝ) := by exact_mod_cast h
    push_cast at this
    rw [div_pow, mul_div_assoc', le_div_iff₀ (by positivity)]
    norm_num at this ⊢; linarith
  -- `p^{-1/3} = (p⁻¹)^{1/3}` and `(r³)^{1/3} = r`
  have e1 : (p : ℝ) ^ (-(1 / 3) : ℝ) = ((p : ℝ)⁻¹) ^ (1 / 3 : ℝ) := by
    rw [Real.rpow_neg hp0.le, Real.inv_rpow hp0.le]
  have e2 : (((k : ℝ) / 10 ^ 6) ^ 3) ^ (1 / 3 : ℝ) = (k : ℝ) / 10 ^ 6 := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hr0]; norm_num
  rw [e1, ← e2]
  apply Real.rpow_le_rpow (by positivity) _ (by norm_num)
  rw [inv_le_iff_one_le_mul₀ hp0]; linarith

theorem list_prod_le {l : List (ℕ × ℕ)} (f g : ℕ × ℕ → ℝ) (h0 : ∀ x ∈ l, 0 ≤ f x)
    (h : ∀ x ∈ l, f x ≤ g x) : (l.map f).prod ≤ (l.map g).prod := by
  induction l with
  | nil => simp
  | cons a l ih =>
    simp only [List.map_cons, List.prod_cons]
    have ha := h a List.mem_cons_self
    have h0a := h0 a List.mem_cons_self
    have hl := ih (fun x hx => h0 x (List.mem_cons_of_mem _ hx))
      (fun x hx => h x (List.mem_cons_of_mem _ hx))
    have hp0 : 0 ≤ (l.map f).prod := List.prod_nonneg (by
      intro y hy
      obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hy
      exact h0 x (List.mem_cons_of_mem _ hx))
    exact mul_le_mul ha hl hp0 (h0a.trans ha)

/-- **`∏_{p < 10⁴} (1 + (p^{−2/3} + p^{−1/3})/(p − 1)) ≤ 7.99`** (kernel-checked). -/
theorem prod_ap_le' : ∏ p ∈ Nat.primesBelow 10000,
    (1 + ((p : ℝ) ^ (-(2 / 3) : ℝ) + (p : ℝ) ^ (-(1 / 3) : ℝ)) / (p - 1)) ≤ 7.99 := by
  have hent := PK_entries
  simp only [List.all_eq_true, entryCheck, Bool.and_eq_true, decide_eq_true_eq] at hent
  rw [primesBelow_eq, List.prod_toFinset _ PK_nodup, List.map_map]
  have hle : ∀ pk ∈ PK, (1 + ((pk.1 : ℝ) ^ (-(2 / 3) : ℝ) + (pk.1 : ℝ) ^ (-(1 / 3) : ℝ)) /
      ((pk.1 : ℝ) - 1)) ≤ ((fac pk : ℚ) : ℝ) := by
    intro pk hpk
    obtain ⟨⟨h1, h2⟩, h3⟩ := hent pk hpk
    have hpr := prime_of_primeCheck h2 h1
    have hp1 : (1 : ℝ) < pk.1 := by exact_mod_cast hpr.one_lt
    have hp0 : (0 : ℝ) < pk.1 := by linarith
    have hr := rpow_third_le hpr.pos h3
    have hr0 : 0 ≤ (pk.1 : ℝ) ^ (-(1 / 3) : ℝ) := Real.rpow_nonneg hp0.le _
    have e : (pk.1 : ℝ) ^ (-(2 / 3) : ℝ) = ((pk.1 : ℝ) ^ (-(1 / 3) : ℝ)) ^ 2 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hp0.le]; norm_num
    unfold fac; push_cast
    rw [e]
    gcongr
  have hnn : ∀ pk ∈ PK, 0 ≤ (1 + ((pk.1 : ℝ) ^ (-(2 / 3) : ℝ) + (pk.1 : ℝ) ^ (-(1 / 3) : ℝ)) /
      ((pk.1 : ℝ) - 1)) := by
    intro pk hpk
    obtain ⟨⟨h1, h2⟩, h3⟩ := hent pk hpk
    have hp1 : (1 : ℝ) < pk.1 := by exact_mod_cast (prime_of_primeCheck h2 h1).one_lt
    have : 0 ≤ (pk.1 : ℝ) ^ (-(2 / 3) : ℝ) := Real.rpow_nonneg (by linarith) _
    have : 0 ≤ (pk.1 : ℝ) ^ (-(1 / 3) : ℝ) := Real.rpow_nonneg (by linarith) _
    have : 0 < (pk.1 : ℝ) - 1 := by linarith
    positivity
  calc (PK.map fun pk => 1 + ((pk.1 : ℝ) ^ (-(2 / 3) : ℝ) + (pk.1 : ℝ) ^ (-(1 / 3) : ℝ)) /
        ((pk.1 : ℝ) - 1)).prod ≤ (PK.map fun pk => ((fac pk : ℚ) : ℝ)).prod :=
        list_prod_le _ _ hnn hle
    _ ≤ 7.99 := by
        have h' := (Rat.cast_le (K := ℝ)).2 PK_prod
        push_cast [List.map_map] at h'
        simpa [Function.comp_def] using h'

end TernaryGoldbach.Prelim.Small
