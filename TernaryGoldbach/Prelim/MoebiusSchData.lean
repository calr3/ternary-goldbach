    (∀ x : ℝ, ((X0 + 1 : ℕ) : ℝ) ≤ x → x < TT →
      |∑ n ∈ Icc 1 ⌊x⌋₊, (μ n : ℝ) / n| * Real.log x ≤ profq ⌊x⌋₊) ∧
    ∃ Sf : ℝ, Ssum (TT - 1) ≤ Sf ∧ Sf ≤ 0.0000362 * TT := by
  obtain ⟨hc, he, -⟩ := st213
  obtain ⟨h1, h2⟩ := mChk_spec cs213 ubsM (X0 + 1) 11519 hc Ssum_X0 mchk_ok
  rw [he] at h1 h2
  refine ⟨fun x hx1 hx2 => h1 x hx1 hx2, _, h2, ?_⟩
  have := (Rat.cast_le (K := ℝ)).2 mfin_le
  push_cast at this; norm_num at this ⊢; linarith

