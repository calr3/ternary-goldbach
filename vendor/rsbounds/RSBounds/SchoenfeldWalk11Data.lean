/-- Theorem 11, (7.4), on `[1, 17)`. -/
theorem small_psi_upper {x : ℝ} (h1 : 1 ≤ x) (h2 : x < 17) :
    Chebyshev.psi x - x < x * ε₀ x := by
  have hx0 : 0 ≤ x := by linarith
  have hn1 : 1 ≤ ⌊x⌋₊ := Nat.le_floor (by exact_mod_cast h1)
  have hn2 : ⌊x⌋₊ < 17 := (Nat.floor_lt hx0).mpr (by exact_mod_cast h2)
  obtain ⟨-, -, h, -⟩ := h11_1 _ hn1 hn2 x (Nat.floor_le hx0) (Nat.lt_floor_add_one x)
  have he : 0 ≤ ε₀ x := by
    unfold Goals.Schoenfeld1976.epsilon0; positivity
  have : 0 ≤ x * ε₀ x := mul_nonneg hx0 he
  simp only [Nat.cast_zero, zero_div] at h
  linarith

