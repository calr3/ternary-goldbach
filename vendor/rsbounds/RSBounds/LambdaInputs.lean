import Mathlib.NumberTheory.ArithmeticFunction.VonMangoldt
import Mathlib.Analysis.SpecialFunctions.Pow.Real

/-!
# The von Mangoldt computations (L) of `mobius003.tex`

Statements only; Mathlib-only. With `a_k = |Λ(k) − 1|`:

* `WeightSumBound`: `A(n) = ∑_{2 ≤ k ≤ n} a_k ≤ 2(n − 1)` for `1 ≤ n ≤ 2²⁰`
  (Lemma 6(a) of the note on that range). For `n ≥ 2` the relative margin is at least `7.8%`.
* `GHBounds`: enclosures of `G(N) = ∑_{2 ≤ k ≤ N} a_k / k` and `H(N) = ∑_{2 ≤ k ≤ N} a_k / √k` at
  the 45 checkpoints of `ghTable`: `N = 2^s` (`1 ≤ s ≤ 20`) and `N = ⌊10^(s/8)⌋` (`24 ≤ s ≤ 48`).
  Each bound is a multiple of `10⁻⁶` lying at least `10⁻⁶` from the value, as computed in floating
  point (exactly rounded summation); the induction of the note uses these values only.
-/

open scoped ArithmeticFunction.vonMangoldt

namespace TernaryGoldbach.RSBounds.LambdaInputs

/-- `A(n) ≤ 2(n − 1)` for `1 ≤ n ≤ 2²⁰`. -/
def WeightSumBound : Prop :=
  ∀ n : ℕ, 1 ≤ n → n ≤ 2 ^ 20 → ∑ k ∈ Finset.Icc 2 n, |Λ k - 1| ≤ 2 * ((n : ℝ) - 1)

/-- `G(N) = ∑_{2 ≤ k ≤ N} |Λ(k) − 1| / k`. -/
noncomputable def G (N : ℕ) : ℝ := ∑ k ∈ Finset.Icc 2 N, |Λ k - 1| / k

/-- `H(N) = ∑_{2 ≤ k ≤ N} |Λ(k) − 1| / √k`. -/
noncomputable def H (N : ℕ) : ℝ := ∑ k ∈ Finset.Icc 2 N, |Λ k - 1| / Real.sqrt k

/-- A checkpoint `N` with enclosures `gLo/10⁶ ≤ G(N) ≤ gHi/10⁶` and `hLo/10⁶ ≤ H(N) ≤ hHi/10⁶`. -/
structure GHRow where
  N : ℕ
  gLo : ℕ
  gHi : ℕ
  hLo : ℕ
  hHi : ℕ

