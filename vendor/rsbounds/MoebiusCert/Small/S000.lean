import MoebiusCert.DefsSmall

/-! Segment checks, generated by `tools/gen_modules.py`. Each is a kernel computation. -/

namespace MoebiusCert.Small

set_option maxRecDepth 100000
set_option Elab.async false

theorem seg_1 : smallCheck 1 0 0 0 1 = true := by decide +kernel
theorem seg_2 : smallCheck 2 1 1 1 (-1) = true := by decide +kernel
theorem seg_4 : smallCheck 4 2 2 (-1) (-2) = true := by decide +kernel
theorem seg_8 : smallCheck 8 3 3 (-2) (-1) = true := by decide +kernel
theorem seg_16 : smallCheck 16 4 4 (-1) (-4) = true := by decide +kernel
theorem seg_32 : smallCheck 32 5 5 (-4) (-1) = true := by decide +kernel
theorem seg_64 : smallCheck 64 6 6 (-1) (-2) = true := by decide +kernel
theorem seg_128 : smallCheck 128 7 7 (-2) (-1) = true := by decide +kernel

end MoebiusCert.Small
