import MoebiusCert.DefsSmall

/-! Segment checks, generated by `tools/gen_modules.py`. Each is a kernel computation. -/

namespace MoebiusCert.Small

set_option maxRecDepth 100000
set_option Elab.async false

theorem seg_256 : smallCheck 256 8 8 (-1) (-4) = true := by decide +kernel
theorem seg_512 : smallCheck 512 9 9 (-4) (-4) = true := by decide +kernel
theorem seg_1024 : smallCheck 1024 10 10 (-4) 7 = true := by decide +kernel
theorem seg_2048 : smallCheck 2048 11 11 7 (-19) = true := by decide +kernel
theorem seg_4096 : smallCheck 4096 12 12 (-19) 22 = true := by decide +kernel
theorem seg_8192 : smallCheck 8192 12 13 22 21 = true := by decide +kernel
theorem seg_12288 : smallCheck 12288 12 13 21 (-32) = true := by decide +kernel
theorem seg_16384 : smallCheck 16384 12 14 (-32) 23 = true := by decide +kernel

end MoebiusCert.Small
